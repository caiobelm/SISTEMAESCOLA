{
  "info": {
    "name": "Sistema Escolar API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Coleção de endpoints principais do sistema escolar {{NOME_DA_ESCOLA}}"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@escola.local\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] }
          }
        }
      ]
    },
    {
      "name": "Biblioteca",
      "item": [
        {
          "name": "Listar obras",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/library/works", "host": ["{{baseUrl}}"], "path": ["library", "works"] }
          }
        },
        {
          "name": "Criar empréstimo",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"copyId\": \"<COPY_ID>\",\n  \"borrowerUserId\": \"<USER_ID>\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/library/loans", "host": ["{{baseUrl}}"], "path": ["library", "loans"] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3333" }
  ]
}
